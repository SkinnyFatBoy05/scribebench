# Local API security. Leave blank only for loopback-only development.
SCRIBE_API_KEY=replace-with-a-long-random-value
SCRIBE_DB_PATH=/data/scribebench.db
SCRIBE_MODEL_PROVIDER=rule-based
SCRIBE_MODEL_VERSION=rule-based-baseline-v1
SCRIBE_MODEL_BASE_URL=http://model:8000
SCRIBE_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
SCRIBE_MODEL_TIMEOUT_SECONDS=60
SCRIBE_QUEUE_CAPACITY=32
SCRIBE_MAX_RETRIES=2
SCRIBE_WORKERS=1
SCRIBE_SEED_DEMO=true

# Pin this to an immutable digest after GPU qualification.
VLLM_IMAGE=vllm/vllm-openai:v0.8.5

