# Local API security. Leave blank only for loopback-only development.
SCRIBE_ENV=local
SCRIBE_API_KEY=replace-with-a-long-random-value
SCRIBE_DB_PATH=/data/scribebench.db
SCRIBE_MODEL_PROVIDER=ollama
SCRIBE_MODEL_VERSION=local-v2
# Docker reaches Ollama on your host; for native API use http://127.0.0.1:11434
SCRIBE_MODEL_BASE_URL=http://host.docker.internal:11434
SCRIBE_MODEL_NAME=qwen3:4b
SCRIBE_MODEL_OUTPUT_MODE=json_object
SCRIBE_MODEL_API_KEY=
SCRIBE_MODELS_FILE=
# Leave unset until an actual synthetic-only pilot is authorised; see docs/pilot-operations.md.
SCRIBE_PILOT_MANIFEST=
SCRIBE_MODEL_TIMEOUT_SECONDS=180
SCRIBE_QUEUE_CAPACITY=32
SCRIBE_MAX_RETRIES=2
SCRIBE_WORKERS=1
SCRIBE_SEED_DEMO=false

# Pin this to an immutable digest after GPU qualification.
VLLM_IMAGE=vllm/vllm-openai:v0.8.5
